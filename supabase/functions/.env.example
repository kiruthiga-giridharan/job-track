# Server-side secrets for the extract-job Edge Function.
# Local:  copy to supabase/functions/.env  (used by `supabase functions serve`)
# Hosted: pnpm supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL and SUPABASE_ANON_KEY are provided automatically by Supabase.)

# Optional but recommended — enables AI extraction. Without it, the assistant
# falls back to basic (non-AI) extraction. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the Claude model (default: claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# Alternative: an Anthropic-compatible gateway (e.g. BytePlus ModelArk Coding Plan).
# Use these INSTEAD of ANTHROPIC_API_KEY. ANTHROPIC_MODEL is required here.
# ANTHROPIC_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/coding
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_MODEL=deepseek-v4-flash

# Optional: comma-separated list of allowed browser origins (default: *).
# ALLOWED_ORIGINS=http://localhost:8443,https://your-app.vercel.app
