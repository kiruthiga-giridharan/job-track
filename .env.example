# Frontend (browser) settings — copy to .env.local and fill in.
# Both values are public by design: data is protected by Row-Level Security.
# Supabase dashboard → Project Settings → API (or "Connect").
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Never put ANTHROPIC_API_KEY or the service-role key here: anything prefixed
# VITE_ is bundled into the browser. Server secrets go in supabase/functions/.env
# (local) or `supabase secrets set` (hosted). See supabase/functions/.env.example.
